# Copia este archivo como .env y ajusta los valores
PORT=3000

# Secreto para firmar las sesiones (cadena larga y aleatoria). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Horas que dura una sesión
SESION_HORAS=10

# Conexión a MySQL / MariaDB (base creada con docs/base de datos.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=almacen_lab

# Días de anticipación para alertas
DIAS_AVISO_CADUCIDAD=30
DIAS_AVISO_MANTENIMIENTO=15
